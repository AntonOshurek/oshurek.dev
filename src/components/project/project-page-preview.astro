---
// ASTRO
import type { CollectionEntry } from 'astro:content';
// UI
import { Tags, DateTime } from '@shared/ui/';
// SHARED
import { BASE_URL } from '@shared';
// STYLES
import './project-preview.scss';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<header class="project-preview project-preview--vertical">
	<h1 class="project-preview__title title-l">{project.data.title}</h1>

	<DateTime date={project.data.date} format="year" additionalStyleClass="project-preview__date" />

	<Tags tags={project.data.tags} additionalStyleClass="project-preview__tags" />

	<p class="project-preview__description paragraph-m">
		{project.data.overview}
	</p>

	<img
		class="project-preview__image"
		src={`${BASE_URL}${project.data.previewImage}`}
		alt=""
		width="246"
		height="180"
		loading="lazy"
	/>
</header>
